# ──────────────────────────────────────────
# Database (shared with backend)
# ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cixiohub:cixiohub@localhost:5432/cixiohub

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MAX_RETRY_ATTEMPTS=4

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@hub.cixio.dev

# ──────────────────────────────────────────
# Twilio (SMS + WhatsApp)
# ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ──────────────────────────────────────────
# Firebase (FCM Push — Android)
# ──────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ──────────────────────────────────────────
# AWS (APNs Push via SNS — iOS)
# ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SNS_PLATFORM_ARN_IOS=

# ──────────────────────────────────────────
# JWT Authentication (Must match hub_backend SECRET_KEY)
# ──────────────────────────────────────────
JWT_SECRET_KEY=dev_secret_key_for_cixiohub_backend_token_signing_12345
JWT_ALGORITHM=HS256

